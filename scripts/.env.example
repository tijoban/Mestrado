# Copie para .env, preencha e exporte (set -a && . ./.env && set +a). O .env NÃO vai para o repositório.
# Todos os valores abaixo são fictícios.

# ── Banco canônico (previsão e coleta) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=capacityplan
POSTGRES_USER=capacityplan
POSTGRES_PASSWORD=troque-esta-senha

# ── Previsão: job mensal (valores padrão em previsao/config.py) ──
# LIMIAR_PCT=80
# HORIZONTE_LSTM_DIAS=30
# JANELA_TENDENCIA_DIAS=90
# HORIZONTE_MAX_ANOS=10
# EPOCAS=40
# PARALELO=2
# FONTES=vcenter,nutanix,clientes
# NIVEIS=total,cluster,host,cliente
# MAX_SERIES=0
# RETOMAR=0
# NUTANIX_ATE=2026-08-25
# NUTANIX_EXCLUIR=cluster-exemplo,host-exemplo-1
# TENDENCIA_ESTAVEL_PP_DIA=0.01

# ── Previsão: experimento walk-forward ──
# WF_HORIZONTE=30
# WF_JANELAS=4
# WF_TREINO_MIN=60
# WF_PARALELO=3

# ── Análise do experimento (previsao/analise_wf.py) ──
# EXECUCAO=1
# SAIDA=resultados_wf
# ANON_MAPA=/caminho/fora/do/repositorio/anonimizacao_wf.csv
# ANONIMIZAR_FIXOS={"Cluster X": "Cluster A", "Cluster Y": "Cluster B"}
# FIGURA_R2_ENTIDADE=Cluster X

# ── Coleta: vCenter ──
VCENTER_HOST=vcenter.exemplo.local
VCENTER_PORT=443
VCENTER_USER=usuario-leitura
VCENTER_PASSWORD=troque-esta-senha

# Opcional: arquivo de log do datacenter_collector.py (padrão /var/log/datacenter_collector.log)
# DATACENTER_LOG_FILE=/tmp/datacenter_collector.log

# ── Coleta: Nutanix ──
# datacenter_collector.py (Prism, API v2)
NUTANIX_HOST=prism.exemplo.local
NUTANIX_USER=usuario-leitura
NUTANIX_PASSWORD=troque-esta-senha
# nutanix_tags.py (Prism Central, API v3)
PRISM_IP_V3=prism-central.exemplo.local
PORT_V3=9440
USERNAME_V3=usuario-leitura
PASSWORD_V3=troque-esta-senha
# nutanix_vms.py (Prism Element de cada cluster; _1, _2, ...)
NUTANIX_HOST_1=prism-element-1.exemplo.local
NUTANIX_USER_1=usuario-leitura
NUTANIX_PASSWORD_1=troque-esta-senha

# ── Coleta: Kubernetes (Prometheus) ──
PROMETHEUS_URL=http://prometheus.exemplo.local:9090

# ── Coleta: storages (storage_collect.py; equipamento sem host é pulado) ──
NETAPP_HOST=netapp.exemplo.local
NETAPP_USER=usuario-leitura
NETAPP_PASSWORD=troque-esta-senha
PURE_HOST=pure.exemplo.local
PURE_USER=usuario-leitura
PURE_PASSWORD=troque-esta-senha
# PURE_API_TOKEN=
# Rótulo gravado em storage_dc.ambiente para os volumes da própria entidade
AMBIENTE_PROPRIO=proprio
